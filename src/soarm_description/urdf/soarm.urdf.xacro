<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="soarm">

  <xacro:arg name="is_sim" default="true"/>

  <xacro:include filename="$(find soarm_description)/urdf/soarm_ros2_control.xacro"/>
  <xacro:include filename="$(find soarm_description)/urdf/soarm_gazebo.xacro"/>

  <xacro:soarm_ros2_control is_sim="$(arg is_sim)"/>
  <xacro:soarm_gazebo is_sim="$(arg is_sim)"/>

  <xacro:property name="PI" value="3.14159"/>
  <!-- Servo Steps converted to Radians -->
  <xacro:property name="RAD_CONV" value = "0.001533979"/>

  <!-- Link base -->
  <link name="base">
    <inertial>
      <origin xyz="-0.14932 -0.16812 0.065966" rpy="0 0 0"/>
      <mass value="0.147"/>
      <inertia ixx="0.000114686" ixy="-4.59787e-07" ixz="4.97151e-06" iyy="0.000136117" iyz="9.75275e-08" izz="0.000130364"/>
    </inertial>
    <!-- Part Base_motor_holder_SO101 -->
    <visual>
    <!--       <origin xyz="-0.00636471 -9.94414e-05 -0.0024" rpy="1.5708 -1.67685e-15 1.5708"/> -->
      <origin xyz="0 0 0" rpy="1.5708 0 1.5708"/>
      <geometry>
        <mesh filename="package://soarm_description/meshes/Base_motor_holder_SO101.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="Base_motor_holder_SO101_material">
        <color rgba="0.964706 0.964706 0.952941 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 1.5708"/>
      <geometry>
        <mesh filename="package://soarm_description/meshes/Base_motor_holder_SO101.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <!-- Part Base_SO101 -->
    <visual>
      <!--       <origin xyz="-0.00636471 -8.97657e-09 -0.0024" rpy="1.5708 -2.78073e-29 1.5708"/> -->
      <origin xyz="0 0 0" rpy="1.5708 0 1.5708"/>
      <geometry>
        <mesh filename="package://soarm_description/meshes/Base_SO101.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="Base_SO101_material">
        <color rgba="0.964706 0.964706 0.952941 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 1.5708"/>
      <geometry>
        <mesh filename="package://soarm_description/meshes/Base_SO101.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <!-- Part WaveShare_Mounting_Plate_SO101 -->
    <visual>
      <origin xyz="-0.0309827 -0.000199441 0.0474" rpy="1.5708 0 1.5708"/>
      <geometry>
        <mesh filename="package://soarm_description/meshes/WaveShare_Mounting_Plate_SO101.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="WaveShare_Mounting_Plate_SO101_material">
        <color rgba="0.964706 0.964706 0.952941 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="-0.0309827 -0.000199441 0.0474" rpy="1.5708 0 1.5708"/>
      <geometry>
        <mesh filename="package://soarm_description/meshes/WaveShare_Mounting_Plate_SO101.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <!-- Frame baseframe (dummy link + fixed joint) | is this world? -->
  <link name="baseframe">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1e-9"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
  </link>
  <joint name="baseframe_frame" type="fixed">
    <origin xyz="-0.163038 -0.168068 0.0324817" rpy="1.6144e-15 7.84513e-18 1.33799e-15" />
    <parent link="base"/>
    <child link="baseframe"/>
    <axis xyz="0 0 0"/>
  </joint>
  <!-- Link shoulder -->
  <link name="shoulder">
    <inertial>
      <!-- <origin xyz="-0.0307604 -1.66727e-05 -0.0252713" rpy="0 0 0"/> -->
      <origin xyz="-0.0307604 -1.66727e-05 -0.0252713" rpy="0 0 0"/> 
      <mass value="0.100006"/>
      <inertia ixx="8.3759e-05" ixy="7.55525e-08" ixz="-1.16342e-06" iyy="8.10403e-05" iyz="1.54663e-07" izz="2.39783e-05"/>
    </inertial>
    <!-- Part Rotation_Pitch_SO101 -->
    <visual>      
<!--       <origin xyz="0.0122008 2.22413e-05 0.0464" rpy="-1.5708 2.35221e-33 0"/> -->
      <origin xyz="0.013 0 0.028" rpy="-1.5708 0 0"/>
      <geometry>
        <mesh filename="package://soarm_description/meshes/Rotation_Pitch_SO101.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="Rotation_Pitch_SO101_material">
        <color rgba="0.964706 0.964706 0.952941 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.013 0 0.028" rpy="-1.5708 0 0"/>
      <geometry>
        <mesh filename="package://soarm_description/meshes/Rotation_Pitch_SO101.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <!-- Link upper_arm -->
  <link name="upper_arm">
    <inertial>
      <origin xyz="-0.0898471 -0.00838224 0.0184089" rpy="0 0 0"/>
      <mass value="0.103"/>
      <inertia ixx="4.08002e-05" ixy="-1.97819e-05" ixz="-4.03016e-08" iyy="0.000147318" iyz="8.97326e-09" izz="0.000142487"/>
    </inertial>
    <!-- Part Upper_arm_SO101 -->
    <visual>
      <!--       <origin xyz="-0.065085 0.012 0.0182" rpy="3.14159 -0 -1.30911e-30"/> -->
      <origin xyz="0.01 .065 0" rpy="3.14159 0 ${3*PI/2}"/>
      <geometry>
        <mesh filename="package://soarm_description/meshes/Upper_arm_SO101.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="Upper_arm_SO101_material">
        <color rgba="0.964706 0.964706 0.952941 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.01 .065 0" rpy="3.14159 0 ${3*PI/2}"/>
      <geometry>
        <mesh filename="package://soarm_description/meshes/Upper_arm_SO101.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <!-- Link lower_arm -->
  <link name="lower_arm">
    <inertial>
      <origin xyz="-0.0980701 0.00324376 0.0182831" rpy="0 0 0"/>
      <mass value="0.104"/>
      <inertia ixx="2.87438e-05" ixy="7.41152e-06" ixz="1.26409e-06" iyy="0.000159844" iyz="-4.90188e-08" izz="0.00014529"/>
<!-- 
      <mass value="1.04"/>
      <inertia ixx="2.87438e-04" ixy="7.41152e-05" ixz="1.26409e-05" iyy="0.00159844" iyz="-4.90188e-07" izz="0.0014529"/> -->
    </inertial>
    <!-- Part Under_arm_SO101 -->
    <visual>
        <!-- <origin xyz="-0.0648499 -0.032 0.0182" rpy="3.14159 -0 6.67202e-31"/> -->
      <origin xyz="-0.0648499 -0.032 0" rpy="3.14159 0 0"/>
      <geometry>
        <mesh filename="package://soarm_description/meshes/Under_arm_SO101.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="Under_arm_SO101_material">
        <color rgba="0.964706 0.964706 0.952941 1.0"/>
      </material>
    </visual>
    <collision>
    <!--       <origin xyz="-0.0648499 -0.032 0.0182" rpy="3.14159 -0 6.67202e-31"/> -->
      <origin xyz="-0.0648499 -0.032 0" rpy="3.14159 0 0"/>
      <geometry>
        <mesh filename="package://soarm_description/meshes/Under_arm_SO101.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    <!-- Troubleshoot with simple box -->
      <!-- <origin xyz="-0.0648499 -0.032 0" rpy="3.14159 0 0"/>
      <geometry>
        <box size="0.5 0.1 0.1"/> 
      </geometry> -->
    </collision>
    <gazebo reference="lower_arm">
      <self_collide>true</self_collide>
      <disableFixedJointLumping>true</disableFixedJointLumping>
    </gazebo>
  </link> 
  <!-- Link wrist -->
  <link name="wrist">
    <inertial>
      <origin xyz="-0.000103312 -0.0386143 0.0281156" rpy="0 0 0"/>
      <mass value="0.079"/>
      <inertia ixx="3.68263e-05" ixy="1.7893e-08" ixz="-5.28128e-08" iyy="2.5391e-05" iyz="3.6412e-06" izz="2.1e-05"/>
    </inertial>
    <!-- Part Wrist_Roll_Pitch_SO101 -->
    <visual>
      <!--<origin xyz="0 -0.028 0.0181" rpy="-1.5708 -1.5708 0"/> -->
      <origin xyz="0 -0.028 0" rpy="-1.5708 -1.5708 0"/>
      <geometry>
        <mesh filename="package://soarm_description/meshes/Wrist_Roll_Pitch_SO101.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="Wrist_Roll_Pitch_SO101_material">
        <color rgba="0.964706 0.964706 0.952941 1.0"/>
      </material>
    </visual>
    <collision>
      <!--<origin xyz="0 -0.028 0.0181" rpy="-1.5708 -1.5708 0"/> -->
      <origin xyz="0 -0.028 0" rpy="-1.5708 -1.5708 0"/>
      <geometry>
        <mesh filename="package://soarm_description/meshes/Wrist_Roll_Pitch_SO101.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <!-- Link gripper -->
  <link name="gripper">
    <inertial>
      <origin xyz="0.000213627 0.000245138 -0.025187" rpy="0 0 0"/>
      <mass value="0.087"/>
      <inertia ixx="2.75087e-05" ixy="-3.35241e-07" ixz="-5.7352e-06" iyy="4.33657e-05" iyz="-5.17847e-08" izz="3.45059e-05"/>
    </inertial>
    <!-- Part Wrist_Roll_Follower_SO101 -->
    <visual>
      <origin xyz="0 0 0" rpy="-3.14159 0 0"/>
      <geometry>
        <mesh filename="package://soarm_description/meshes/Wrist_Roll_Follower_SO101.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="Wrist_Roll_Follower_SO101_material">
        <color rgba="0.964706 0.964706 0.952941 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="-3.14159 0 0"/>
      <geometry>
        <mesh filename="package://soarm_description/meshes/Wrist_Roll_Follower_SO101.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <!-- Frame gripperframe (dummy link + fixed joint) -->
  <link name="gripperframe">
    <origin xyz="0 0 0" rpy="0 -0 0"/>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1e-9"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
  </link>
  <joint name="gripperframe_frame" type="fixed">
    <origin xyz="-0.0079 -0.000218121 -0.0981274" rpy="0 3.14159 0"/>
    <parent link="gripper"/>
    <child link="gripperframe"/>
    <axis xyz="0 0 0"/>
  </joint>
  <!-- Link Moving_Jaw_SO101 -->
  <link name="Moving_Jaw_SO101">
    <inertial>
      <origin xyz="-0.00157495 -0.0300244 0.0192755" rpy="0 0 0"/>
      <mass value="0.012"/>
      <inertia ixx="6.61427e-06" ixy="-3.19807e-07" ixz="-5.90717e-09" iyy="1.89032e-06" iyz="-1.09945e-07" izz="5.28738e-06"/>
    </inertial>
    <!-- Part Moving_Jaw_SO101, should be 0 0 0-->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://soarm_description/meshes/Moving_Jaw_SO101.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="Moving_Jaw_SO101_material">
        <color rgba="0.964706 0.964706 0.952941 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://soarm_description/meshes/Moving_Jaw_SO101.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <!-- Need fixed joint to "world" link to prevent robot from falling over in Gazebo -->
  <link name="world"/>

  <joint name="virtual_joint" type="fixed">
    <parent link="world"/>
    <child link="base"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Joint from gripper to Moving_Jaw_SO101 -->
  <joint name="gripper_joint" type="revolute">
    <origin xyz="0.0202 0 -0.0234" rpy="1.5708 0 0"/>
    <parent link="gripper"/>
    <child link="Moving_Jaw_SO101"/>
    <axis xyz="0 0 1"/>
    <!-- is_sim true is Gazebo, false is live -->
    <xacro:if value="$(arg is_sim)">
      <limit effort="10" velocity="10" lower="-0.174533" upper="1.74533"/>
    </xacro:if>
    <xacro:unless value="$(arg is_sim)">
      <limit effort="10" velocity="10" lower="${1300*RAD_CONV}" upper="${2800*RAD_CONV}"/>
    </xacro:unless>
    </joint>
  <!-- Joint from wrist to gripper -->
  <joint name="wrist_roll" type="revolute">
    <origin xyz="0 -0.0611 0.0181" rpy="1.5708 0.0486795 3.14159"/>
    <parent link="wrist"/>
    <child link="gripper"/>
    <axis xyz="0 0 1"/>

    <xacro:if value="$(arg is_sim)">
      <limit effort="10" velocity="10" lower="${-7*PI/8}" upper="${7*PI/8}"/>
    </xacro:if>
    <xacro:unless value="$(arg is_sim)">
      <limit effort="10" velocity="10" lower="${430*RAD_CONV}" upper="${4070*RAD_CONV}"/>
    </xacro:unless>
    </joint>
  <!-- Joint from lower_arm to wrist -->
  <joint name="wrist_flex" type="revolute">
    <origin xyz="-0.1349 0.004 0" rpy="4.02456e-15 8.67362e-16 -1.5708"/>
    <parent link="lower_arm"/>
    <child link="wrist"/>
    <axis xyz="0 0 1"/>

    <xacro:if value="$(arg is_sim)">
      <limit effort="10" velocity="10" lower="-1.2" upper="1.2"/>
    </xacro:if>
    <xacro:unless value="$(arg is_sim)">
      <limit effort="10" velocity="10" lower="${1200*RAD_CONV}" upper="${3200*RAD_CONV}"/>
    </xacro:unless>
  </joint>
  <!-- Joint from upper_arm to lower_arm -->
  <joint name="elbow_flex" type="revolute">
    <origin xyz="-0.029 .113 0.004" rpy="0 0 ${PI/2}"/>
    <parent link="upper_arm"/>
    <child link="lower_arm"/>
    <axis xyz="0 0 1"/>

    <xacro:if value="$(arg is_sim)">
      <limit effort="10" velocity="10" lower="${-PI}" upper="0"/>
    </xacro:if>
    <xacro:unless value="$(arg is_sim)">
      <limit effort="10" velocity="10" lower="${500*RAD_CONV}" upper="${2600*RAD_CONV}"/>
    </xacro:unless>
    </joint>
  <!-- Joint from shoulder to upper_arm -->
  <joint name="shoulder_lift" type="revolute">
    <origin xyz="-0.03138 0 -0.072" rpy="${-PI/2} ${-PI/2} 0"/>
    <parent link="shoulder"/>
    <child link="upper_arm"/>
    <axis xyz="0 0 1"/>

    <xacro:if value="$(arg is_sim)">
      <limit effort="10" velocity="10" lower="-0.3" upper="${PI}"/>
    </xacro:if>
    <xacro:unless value="$(arg is_sim)">
      <limit effort="10" velocity="10" lower="${850*RAD_CONV}" upper="${3500*RAD_CONV}"/>
    </xacro:unless>
    </joint>
  <!-- Joint from base to shoulder -->
  <joint name="shoulder_pan" type="revolute">
    <origin xyz="0.04572 0 0.048" rpy="${PI} 0 ${-PI}"/>
    <parent link="base"/>
    <child link="shoulder"/>
    <axis xyz="0 0 1"/>

    <xacro:if value="$(arg is_sim)">
      <limit effort="10" velocity="10" lower="${-3*PI/5}" upper="${3*PI/5}"/>
    </xacro:if>
    <xacro:unless value="$(arg is_sim)">
      <limit effort="10" velocity="10" lower="${1130*RAD_CONV}" upper="${3730*RAD_CONV}"/>
    </xacro:unless>
    </joint>
</robot>
